<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Limlin.Bootstrapper</AssemblyName>
        <RootNamespace>Limlin.Bootstrapper</RootNamespace>
        <AssemblyTitle>栎木栎林社区启动器</AssemblyTitle>
        <Description>栎木栎林社区启动器的自解压引导程序</Description>
        <Company>Limlin Community</Company>
        <Product>Limlin Launcher</Product>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <ApplicationIcon>..\PCL.Launcher\Assets\Images\icon.ico</ApplicationIcon>
        <!-- 由发布脚本通过 -p:Version= 覆盖 -->
        <Version>0.0.0</Version>
    </PropertyGroup>
</Project>
